{
  "name": "davidwesst-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "clean": "node tools/clean.mjs",
    "build": "pnpm run clean && pnpm run build:site && pnpm run build:css",
    "build:site": "eleventy",
    "build:css": "tailwindcss -i ./src/styles/main.css -o ./_site/assets/main.css --minify",
    "dev": "concurrently --kill-others \"eleventy --serve\" \"tailwindcss -i ./src/styles/main.css -o ./_site/assets/main.css --watch=always\"",
    "start": "pnpm run dev",
    "test": "pnpm run build && node --test tests/site.test.js"
  },
  "engines": {
    "node": ">=24 <27",
    "pnpm": ">=11 <12"
  },
  "packageManager": "pnpm@11.2.1",
  "dependencies": {
    "@11ty/eleventy": "^3.1.5",
    "@11ty/eleventy-plugin-webc": "^0.11.2",
    "@tailwindcss/cli": "^4.1.11",
    "concurrently": "^9.2.0",
    "tailwindcss": "^4.1.11"
  }
}
