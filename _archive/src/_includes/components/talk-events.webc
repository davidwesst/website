<script webc:setup>
  function eventForRef(ref, events = []) {
    return events.find((event) => event.id === ref.eventId);
  }

  function coPresentersText(ref) {
    return (ref.meta?.coPresenters || []).join(", ");
  }
</script>

<section webc:if="talk.eventRefs && talk.eventRefs.length" class="mt-12 border-t border-slate-200 pt-8">
  <h2 class="text-2xl font-bold text-slate-900">Delivered At</h2>
  <ol class="mt-5 space-y-4">
    <li webc:for="ref of talk.eventRefs" class="rounded-lg bg-slate-50 p-5">
      <article>
        <h3 class="text-lg font-bold text-slate-900">
          <a class="hover:text-teal-700" :href="eventForRef(ref, events).canonicalUrl" @text="eventForRef(ref, events).title"></a>
        </h3>
        <p webc:if="eventForRef(ref, events).dates.start" class="mt-2 text-sm text-slate-500">
          <time :datetime="eventForRef(ref, events).dates.start" @text="eventForRef(ref, events).dates.start"></time>
          <span webc:if="eventForRef(ref, events).dates.end"> to </span>
          <time
            webc:if="eventForRef(ref, events).dates.end"
            :datetime="eventForRef(ref, events).dates.end"
            @text="eventForRef(ref, events).dates.end"
          ></time>
        </p>
        <p webc:if="eventForRef(ref, events).location" class="mt-2 text-slate-600" @text="eventForRef(ref, events).location"></p>
        <p webc:if="ref.meta && ref.meta.coPresenters && ref.meta.coPresenters.length" class="mt-2 text-slate-600">
          Co-presented with <span @text="coPresentersText(ref)"></span>
        </p>
        <content-links :@items="ref.links"></content-links>
      </article>
    </li>
  </ol>
</section>
