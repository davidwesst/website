<script webc:setup>
  function latestDocuments(items = []) {
    return [...items]
      .filter((item) => item.docType !== "page")
      .sort((first, second) => {
        const firstDate = first.dates?.sort || first.dates?.published || "";
        const secondDate = second.dates?.sort || second.dates?.published || "";
        return secondDate.localeCompare(firstDate);
      })
      .slice(0, 5);
  }
</script>

<section class="mx-auto max-w-3xl py-10 text-center" aria-labelledby="home-title">
  <h1 id="home-title" class="text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl">David Wesst</h1>
  <p class="mt-4 text-xl leading-8 text-slate-600">Technology problem solver using creativity, code, and curiosity.</p>
</section>

<nav class="my-10" aria-labelledby="home-sections-title">
  <h2 id="home-sections-title" class="text-center text-2xl font-bold text-slate-900">Sections</h2>
  <ul class="mt-5 flex flex-wrap justify-center gap-3">
    <li><a class="block rounded-full bg-slate-100 px-4 py-2 text-slate-700 hover:bg-teal-700 hover:text-white" href="/about/">About</a></li>
    <li><a class="block rounded-full bg-slate-100 px-4 py-2 text-slate-700 hover:bg-teal-700 hover:text-white" href="/projects/">Projects</a></li>
    <li><a class="block rounded-full bg-slate-100 px-4 py-2 text-slate-700 hover:bg-teal-700 hover:text-white" href="/blog/">Blog</a></li>
    <li><a class="block rounded-full bg-slate-100 px-4 py-2 text-slate-700 hover:bg-teal-700 hover:text-white" href="/talks/">Talks</a></li>
    <li><a class="block rounded-full bg-slate-100 px-4 py-2 text-slate-700 hover:bg-teal-700 hover:text-white" href="/events/">Events</a></li>
    <li><a class="block rounded-full bg-slate-100 px-4 py-2 text-slate-700 hover:bg-teal-700 hover:text-white" href="/blog/?series=gamelog">Gamelog</a></li>
    <li><a class="block rounded-full bg-slate-100 px-4 py-2 text-slate-700 hover:bg-teal-700 hover:text-white" href="/blog/?series=dungeonlog">Dungeonlog</a></li>
  </ul>
</nav>

<section class="my-10" aria-labelledby="home-social-title">
  <h2 id="home-social-title" class="text-center text-2xl font-bold text-slate-900">Connect</h2>
  <social-links :@items="socials"></social-links>
</section>

<section class="my-16" aria-labelledby="latest-title">
  <h2 id="latest-title" class="mb-8 text-center text-3xl font-bold text-slate-900">Latest</h2>
  <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
  <article webc:for="item of latestDocuments(documents)" class="rounded-lg bg-white p-6 shadow-md transition-shadow hover:shadow-lg">
    <p class="text-sm text-slate-500">
      <time webc:if="item.dates && item.dates.published" :datetime="item.dates.published" @text="item.dates.published"></time>
      <span webc:if="item.series"> / </span>
      <span webc:if="item.series" @text="item.series"></span>
    </p>
    <h3 class="mt-3 text-xl font-bold text-slate-900"><a class="hover:text-teal-700" :href="item.canonicalUrl" @text="item.title"></a></h3>
    <p webc:if="item.summary" class="mt-3 text-slate-600" @text="item.summary"></p>
  </article>
  </div>
</section>
