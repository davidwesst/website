---
title: Site Index
layout: base.webc
---
<header class="mx-auto mb-10 max-w-3xl text-center">
  <h1 class="text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl">Site Index</h1>
  <p class="mt-4 text-lg text-slate-600">Top-level pages generated by the static site build.</p>
</header>

<section class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3" aria-label="Site pages">
  <article webc:for="entry of collections.siteIndexPages" class="rounded-lg bg-white p-6 shadow-md">
    <h2 class="text-xl font-bold text-slate-900"><a class="hover:text-teal-700" :href="entry.url" @text="entry.data.title || entry.url"></a></h2>
    <p class="mt-2 text-sm text-slate-500" @text="entry.url"></p>
  </article>
</section>
