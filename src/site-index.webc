---
title: Site Index
layout: base.webc
---
<header>
  <h1>Site Index</h1>
  <p>Top-level pages generated by the static site build.</p>
</header>

<section aria-label="Site pages">
  <article webc:for="entry of collections.siteIndexPages">
    <h2><a :href="entry.url" @text="entry.data.title || entry.url"></a></h2>
    <p @text="entry.url"></p>
  </article>
</section>
