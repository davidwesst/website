---
title: Blog
layout: base.webc
---
<header class="mx-auto mb-10 max-w-3xl text-center">
  <h1 class="text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl">Blog</h1>
  <p class="mt-4 text-lg text-slate-600">Writing, game notes, and campaign logs.</p>
</header>

<form class="flex flex-wrap justify-center gap-4 rounded-lg bg-slate-100 p-4" data-post-filters aria-label="Post filters">
  <label class="flex items-center gap-2"><input class="accent-teal-700" type="checkbox" name="series" value="blog" checked> Blog</label>
  <label class="flex items-center gap-2"><input class="accent-teal-700" type="checkbox" name="series" value="gamelog"> Gamelog</label>
  <label class="flex items-center gap-2"><input class="accent-teal-700" type="checkbox" name="series" value="dungeonlog"> Dungeonlog</label>
</form>

<nav class="mt-5 flex flex-wrap justify-center gap-4 text-sm" aria-label="Blog feeds">
  <a class="text-teal-700 hover:underline" href="/blog/feed.xml">Blog RSS</a>
  <a class="text-teal-700 hover:underline" href="/blog/gamelog/feed.xml">Gamelog RSS</a>
  <a class="text-teal-700 hover:underline" href="/blog/dungeonlog/feed.xml">Dungeonlog RSS</a>
</nav>

<p class="my-6 text-center text-sm text-slate-500" data-post-count aria-live="polite"></p>

<section class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3" data-post-list aria-live="polite" aria-label="Posts">
  <article
    class="overflow-hidden rounded-lg bg-white shadow-md transition-shadow hover:shadow-lg"
    webc:for="post of collections.posts"
    data-post-item
    :data-series="post.series"
    :hidden="post.series !== 'blog'"
  >
    <img class="h-48 w-full object-cover"
      webc:if="post.media && post.media.image"
      :src="post.media.image"
      :alt="post.media.imageAlt || ''"
      loading="lazy"
    >
    <div class="p-6">
      <p class="text-xs font-semibold uppercase tracking-wide text-teal-700" @text="post.series"></p>
      <h2 class="mt-2 text-xl font-bold text-slate-900"><a class="hover:text-teal-700" :href="post.canonicalUrl" @text="post.title"></a></h2>
      <p webc:if="post.dates && post.dates.published" class="mt-2 text-sm text-slate-500" @text="post.dates.published"></p>
      <p webc:if="post.summary" class="mt-3 text-slate-600" @text="post.summary"></p>
    </div>
  </article>
</section>

<script webc:keep>
  (() => {
    const form = document.querySelector("[data-post-filters]");
    const list = document.querySelector("[data-post-list]");
    const count = document.querySelector("[data-post-count]");

    if (!form || !list) {
      return;
    }

    const items = [...list.querySelectorAll("[data-post-item]")];
    const seriesInputs = [...form.querySelectorAll('input[name="series"]')];
    const defaultSeries = ["blog"];

    function selectedSeriesFromUrl() {
      const params = new URLSearchParams(window.location.search);

      if (!params.has("series")) {
        return defaultSeries;
      }

      return params
        .get("series")
        .split(",")
        .map((value) => value.trim())
        .filter(Boolean);
    }

    function applySeries(series) {
      const selected = new Set(series);
      let visibleCount = 0;

      for (const input of seriesInputs) {
        input.checked = selected.has(input.value);
      }

      for (const item of items) {
        const isVisible = selected.has(item.dataset.series);
        item.hidden = !isVisible;

        if (isVisible) {
          visibleCount += 1;
        }
      }

      if (count) {
        count.textContent = `${visibleCount} posts`;
      }

    }

    function updateUrlFromForm() {
      const selected = seriesInputs.filter((input) => input.checked).map((input) => input.value);
      const params = new URLSearchParams(window.location.search);

      if (selected.length === 1 && selected[0] === "blog") {
        params.delete("series");
      } else {
        params.set("series", selected.join(","));
      }

      const query = params.toString();
      window.history.replaceState({}, "", query ? `${window.location.pathname}?${query}` : window.location.pathname);
      applySeries(selected);
    }

    applySeries(selectedSeriesFromUrl());
    form.addEventListener("change", updateUrlFromForm);
    window.addEventListener("popstate", () => applySeries(selectedSeriesFromUrl()));
  })();
</script>
