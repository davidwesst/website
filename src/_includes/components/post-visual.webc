<script webc:setup>
  function configFor(type, site) {
    return site.postTypes[type] || { label: type, iconClass: "fa-solid fa-file", fallbackColor: "#334155" };
  }
  function imageSource(banner, baseUrl) {
    if (!banner?.src || !baseUrl || !banner.src.startsWith("./")) return banner?.src;
    return `${baseUrl}${banner.src.slice(2)}`;
  }
</script>

<figure class="overflow-hidden bg-slate-200" :class="featured ? 'aspect-[16/9] md:aspect-auto md:h-full' : 'aspect-video'">
  <img webc:if="banner && banner.src" class="h-full w-full object-cover" :src="imageSource(banner, baseUrl)" :alt="banner.alt">
  <div webc:if="!banner || !banner.src" class="flex h-full min-h-48 w-full items-center justify-center text-white" :style="`background-color: ${configFor(type, site).fallbackColor}`" role="img" :aria-label="`${configFor(type, site).label} placeholder image`">
    <i :class="`${configFor(type, site).iconClass} text-6xl opacity-90`" aria-hidden="true"></i>
  </div>
  <figcaption webc:if="banner && banner.credit" class="bg-slate-950 px-4 py-2 text-xs text-slate-300" @text="banner.credit"></figcaption>
</figure>
