<script webc:setup>
  function hasDetails(game) {
    return game && (game.firstReleaseDate || game.developers?.length || game.publishers?.length || game.series?.length);
  }
  function formatDate(value) {
    return new Intl.DateTimeFormat("en-CA", { dateStyle: "long", timeZone: "UTC" }).format(new Date(`${value}T00:00:00Z`));
  }
</script>

<section webc:if="hasDetails(game)" aria-labelledby="game-details-heading">
  <h2 id="game-details-heading">Game details</h2>
  <dl class="game-detail-list">
    <div class="game-detail-card" webc:if="game.firstReleaseDate">
      <dt>Released</dt><dd><time :datetime="game.firstReleaseDate" @text="formatDate(game.firstReleaseDate)"></time></dd>
    </div>
    <div class="game-detail-card" webc:if="game.developers && game.developers.length">
      <dt @text="game.developers.length === 1 ? 'Developer' : 'Developers'"></dt><dd @text="game.developers.join(', ')"></dd>
    </div>
    <div class="game-detail-card" webc:if="game.publishers && game.publishers.length">
      <dt @text="game.publishers.length === 1 ? 'Publisher' : 'Publishers'"></dt><dd @text="game.publishers.join(', ')"></dd>
    </div>
    <div class="game-detail-card" webc:if="game.series && game.series.length">
      <dt>Series</dt><dd @text="game.series.join(', ')"></dd>
    </div>
  </dl>
</section>
