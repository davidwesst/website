<script webc:setup>
  function sortedPages(items) {
    return [...(items || [])].sort((left, right) => left.data.title.localeCompare(right.data.title));
  }
</script>

<footer class="bg-slate-950 text-slate-300">
  <div class="mx-auto flex max-w-6xl flex-col gap-8 px-6 py-12 md:flex-row md:items-end md:justify-between">
    <div>
      <p class="text-xl font-black text-white" @text="site.title"></p>
      <p class="mt-2 max-w-xl text-sm text-slate-400" @text="site.tagline"></p>
      <div class="mt-5"><social-links :@items="site.socialLinks" :@centered="false"></social-links></div>
    </div>
    <nav aria-label="Footer navigation">
      <ul class="flex flex-wrap gap-x-5 gap-y-2 text-sm">
        <li><a href="/">Home</a></li>
        <li><a href="/blog/">Blog</a></li>
        <li><a href="/talks/">Talks</a></li>
        <li webc:for="item of sortedPages(pages)"><a :href="item.url" @text="item.data.title"></a></li>
        <li><a href="/topics/">Topics</a></li>
      </ul>
    </nav>
  </div>
  <p class="border-t border-slate-800 px-6 py-5 text-center text-xs text-slate-500">Copyright David Wesst.</p>
</footer>
