<script webc:setup>
  function formatDate(value) {
    if (!value) return "";
    return new Intl.DateTimeFormat("en-CA", {
      year: "numeric",
      month: "long",
      day: "numeric",
      timeZone: "UTC",
    }).format(new Date(value));
  }
</script>

<article class="mx-auto max-w-3xl">
  <header class="mb-10 text-center">
    <p class="text-sm font-semibold uppercase tracking-wide text-teal-700" @text="post.series"></p>
    <h1 class="mt-3 text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl" @text="post.title"></h1>
    <p webc:if="post.dates && post.dates.published" class="mt-4 text-slate-500">
      <time :datetime="post.dates.published" @text="formatDate(post.dates.published)"></time>
    </p>
    <ul webc:if="post.taxonomy && post.taxonomy.tags && post.taxonomy.tags.length" class="mt-5 flex flex-wrap justify-center gap-2" aria-label="Tags">
      <li webc:for="tag of post.taxonomy.tags" class="rounded-full bg-slate-100 px-3 py-1 text-sm text-slate-600" @text="tag"></li>
    </ul>
  </header>

  <img
    webc:if="post.media && post.media.image"
    class="mb-10 w-full rounded-lg object-cover shadow-md"
    :src="post.media.image"
    :alt="post.media.imageAlt || ''"
  >
  <p webc:if="post.summary" class="mb-8 text-xl leading-8 text-slate-600" @text="post.summary"></p>
  <review-meta webc:if="post.review" :@review="post.review"></review-meta>
  <markdown-content :@value="renderedBody"></markdown-content>
</article>
