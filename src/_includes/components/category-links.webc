<script webc:setup>
  function slug(value) {
    return String(value).normalize("NFKD").toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "");
  }
</script>

<nav webc:if="categories && categories.length" aria-label="Categories">
  <ul>
    <li webc:for="category of categories">
      <a :href="`/categories/${slug(category)}/`" @text="category"></a>
    </li>
  </ul>
</nav>
