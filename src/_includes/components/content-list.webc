<script webc:setup>
  function hasVisualCard(item, site) {
    return Boolean(site.postTypes[item.data.type]);
  }
  function descriptionForItem(item, describe) {
    return describe ? describe(item) : item.data.summary;
  }
</script>

<ol :id="filterable ? 'blog-post-list' : undefined" class="mt-8 grid list-none gap-8 p-0" :class="singleColumn ? 'md:grid-cols-1 lg:grid-cols-1' : 'md:grid-cols-2 lg:grid-cols-3'">
  <li webc:for="item of items" class="min-w-0" :data-content-type="filterable ? item.data.type : undefined">
    <post-card webc:if="hasVisualCard(item, site)" :@item="item" :@site="site" :@featured="false" :@description="descriptionForItem(item, descriptionFor)" :@crop-banner="singleColumn"></post-card>
    <article webc:if="!hasVisualCard(item, site)" class="h-full overflow-hidden rounded-lg bg-white p-7 shadow-lg transition hover:-translate-y-1 hover:shadow-xl">
      <p class="text-xs font-bold uppercase tracking-widest text-teal-700" @text="item.data.type || 'Content'"></p>
      <h2 class="mt-3 text-2xl font-black leading-tight"><a class="text-slate-950 no-underline hover:text-teal-700" :href="item.url" @text="item.data.title"></a></h2>
      <p webc:if="item.date" class="mt-4 text-xs font-semibold uppercase tracking-wider text-slate-500"><content-date :@value="item.date"></content-date></p>
      <p webc:if="item.data.summary" class="mt-4 font-serif leading-7 text-slate-600" @text="item.data.summary"></p>
    </article>
  </li>
</ol>
