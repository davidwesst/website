<form class="mt-8 rounded-lg border border-slate-200 bg-white p-5 shadow-sm" data-content-type-filter>
  <fieldset>
    <legend class="text-sm font-black uppercase tracking-wider text-slate-700">Filter posts</legend>
    <div class="mt-3 flex flex-wrap gap-x-6 gap-y-3">
      <label class="flex cursor-pointer items-center gap-2 font-semibold text-slate-700">
        <input class="h-4 w-4 accent-teal-700" type="checkbox" value="article" aria-controls="blog-post-list" checked>
        Articles
      </label>
      <label class="flex cursor-pointer items-center gap-2 font-semibold text-slate-700">
        <input class="h-4 w-4 accent-teal-700" type="checkbox" value="dungeonlog" aria-controls="blog-post-list" checked>
        Dungeonlogs
      </label>
      <label class="flex cursor-pointer items-center gap-2 font-semibold text-slate-700">
        <input class="h-4 w-4 accent-teal-700" type="checkbox" value="gamelog" aria-controls="blog-post-list" checked>
        Gamelogs
      </label>
    </div>
  </fieldset>
  <p class="mt-3 text-sm text-slate-500" data-filter-status aria-live="polite">Showing all posts.</p>
</form>

<script webc:keep>
  document.addEventListener("DOMContentLoaded", () => {
    const filter = document.querySelector("[data-content-type-filter]");
    const list = document.querySelector("#blog-post-list");
    if (!filter || !list) return;

    const checkboxes = [...filter.querySelectorAll("input[type='checkbox']")];
    const items = [...list.querySelectorAll("[data-content-type]")];
    const status = filter.querySelector("[data-filter-status]");

    function updateVisiblePosts() {
      const selectedTypes = new Set(checkboxes.filter((checkbox) => checkbox.checked).map((checkbox) => checkbox.value));
      let visibleCount = 0;
      for (const item of items) {
        item.hidden = !selectedTypes.has(item.dataset.contentType);
        if (!item.hidden) visibleCount++;
      }
      status.textContent = visibleCount === 0
        ? "Showing 0 posts? That's silly."
        : `Showing ${visibleCount} ${visibleCount === 1 ? "post" : "posts"}.`;
    }

    filter.addEventListener("change", updateVisiblePosts);
    updateVisiblePosts();
  }, { once: true });
</script>
