<figure webc:if="banner && banner.src" class="overflow-hidden bg-slate-200">
  <responsive-image :@image="banner" image-class="h-auto w-full object-cover" :sizes="banner.responsive?.sizes.detail"></responsive-image>
  <figcaption webc:if="banner.credit" class="bg-slate-950 px-4 py-2 text-xs text-slate-300" @text="banner.credit"></figcaption>
</figure>
