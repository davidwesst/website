---
layout: base.webc
---
<script webc:setup>
  function formatDate(value) {
    return new Intl.DateTimeFormat("en-CA", { dateStyle: "long", timeZone: "UTC" }).format(new Date(value));
  }
</script>

<article>
  <header>
    <p>Talk</p>
    <h1 @text="title"></h1>
    <p>Published <time :datetime="date" @text="formatDate(date)"></time></p>
    <p webc:if="updated">Updated <time :datetime="updated" @text="formatDate(updated)"></time></p>
    <category-links :@categories="categories"></category-links>
  </header>
  <content-banner :@banner="banner"></content-banner>
  <p webc:if="summary" @text="summary"></p>
  <section webc:if="content" aria-label="Talk description" @raw="content"></section>
  <talk-details :@custom-data="customData"></talk-details>
</article>
