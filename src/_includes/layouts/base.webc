<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="The personal website of David Wesst.">
    <link webc:keep rel="stylesheet" href="/assets/main.css">
    <title @text="title"></title>
  </head>
  <body class="min-h-screen bg-black text-white antialiased">
    <main class="mx-auto flex min-h-screen max-w-3xl items-center px-6 py-16">
      <article class="space-y-5 text-lg leading-8 text-white [&_h1]:text-4xl [&_h1]:font-semibold [&_h1]:tracking-tight" @raw="content"></article>
    </main>
  </body>
</html>
