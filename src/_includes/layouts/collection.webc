---
layout: base.webc
---
<script webc:setup>
  function collectionItems(collections, name) {
    return [...(collections[name] || [])].sort((left, right) => right.date - left.date);
  }
</script>

<section>
  <header class="max-w-3xl">
    <p class="text-sm font-bold uppercase tracking-[0.2em] text-teal-700">Collection</p>
    <h1 class="mt-3 text-4xl font-black tracking-tight text-slate-950 md:text-5xl" @text="title"></h1>
    <div class="prose-content mt-4 text-lg text-slate-600" @raw="content"></div>
  </header>
  <content-list :@items="collectionItems(collections, collectionName)" :@site="site"></content-list>
</section>
