---
layout: base.webc
---
<section>
  <header class="max-w-3xl">
    <p class="text-sm font-bold uppercase tracking-[0.2em] text-teal-700">Browse</p>
    <h1 class="mt-3 text-4xl font-black tracking-tight text-slate-950 md:text-5xl" @text="title"></h1>
    <p class="mt-4 font-serif text-lg leading-8 text-slate-600">Explore posts and talks by topic.</p>
  </header>
  <ul class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    <li webc:for="topic of collections.topicPages">
      <a class="flex items-center justify-between rounded-lg bg-white p-5 font-bold text-slate-950 no-underline shadow transition hover:-translate-y-1 hover:text-teal-700 hover:shadow-lg" :href="`/topics/${topic.slug}/`">
        <span @text="topic.name"></span>
        <span class="rounded-full bg-teal-50 px-3 py-1 text-xs text-teal-800" @text="topic.items.length"></span>
      </a>
    </li>
  </ul>
</section>
