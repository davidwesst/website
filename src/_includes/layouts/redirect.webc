---
layout: base.webc
---
<section class="mx-auto max-w-2xl rounded-xl bg-white p-8 text-center shadow-xl md:p-14">
  <p class="text-sm font-bold uppercase tracking-[0.2em] text-teal-700">Moved</p>
  <h1 class="mt-3 text-3xl font-black text-slate-950" @text="title"></h1>
  <p class="mt-5 text-slate-600">This page is now available under Topics.</p>
  <p class="mt-8"><a class="inline-block rounded-full bg-teal-700 px-6 py-3 font-bold text-white no-underline hover:bg-teal-800" :href="targetUrl">Continue to the new page</a></p>
  <script webc:keep :data-target="targetUrl">window.location.replace(document.currentScript.dataset.target);</script>
</section>
