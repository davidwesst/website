---
layout: base.webc
---
<script webc:setup>
  const homeContent = home.prepare([...(collections.posts || []), ...(collections.talks || [])], site.recentPostCount);
</script>

<section class="-mt-28 md:-mt-36" aria-labelledby="featured-heading">
  <h2 id="featured-heading" class="sr-only">Featured posts</h2>
  <div class="featured-rotation" data-featured-rotation>
    <div class="featured-tabs" role="tablist" aria-label="Featured post types">
      <button webc:for="feature, index of homeContent.featured" type="button" role="tab" class="featured-tab" :id="`featured-tab-${index}`" :aria-controls="`featured-panel-${index}`" :aria-selected="index === 0 ? 'true' : 'false'" :tabindex="index === 0 ? '0' : '-1'">
        <i :class="site.postTypes[feature.item.data.type].iconClass" aria-hidden="true"></i>
        <span @text="site.postTypes[feature.item.data.type].label"></span>
      </button>
    </div>
    <div webc:for="feature, index of homeContent.featured" role="tabpanel" class="featured-panel" :id="`featured-panel-${index}`" :aria-labelledby="`featured-tab-${index}`" :hidden="index !== 0">
      <post-card :@item="feature.item" :@site="site" :@featured="true" :@description="feature.description"></post-card>
    </div>
  </div>
  <script webc:keep src="/assets/featured-rotation.js" defer></script>
</section>

<section class="py-16" aria-labelledby="recent-heading">
  <div class="flex flex-wrap items-end justify-between gap-4">
    <div>
      <p class="text-sm font-bold uppercase tracking-[0.2em] text-teal-700">From the blog</p>
      <h2 id="recent-heading" class="mt-2 text-3xl font-black tracking-tight text-slate-950 md:text-4xl">Latest posts</h2>
    </div>
    <a class="font-bold text-teal-700 hover:text-teal-900" href="/blog/">View the full blog <span aria-hidden="true">→</span></a>
  </div>
  <nav class="mt-8 flex flex-wrap gap-x-6 gap-y-3" aria-label="Featured post archives">
    <a webc:for="section of site.homeSections" class="font-bold text-teal-700 hover:text-teal-900" :id="`home-${section.type}`" :href="section.url"><span @text="section.label"></span> <span aria-hidden="true">→</span></a>
  </nav>
  <ol class="home-posts mt-6 grid list-none gap-8 p-0 md:grid-cols-2">
    <li webc:for="item of homeContent.mosaic"><post-card :@item="item" :@site="site" :@featured="false" :@description="item.data.summary"></post-card></li>
  </ol>
</section>

<section class="rounded-xl bg-white p-8 shadow-lg md:p-12" aria-labelledby="explore-heading">
  <p class="text-sm font-bold uppercase tracking-[0.2em] text-teal-700">More to explore</p>
  <h2 id="explore-heading" class="mt-2 text-3xl font-black text-slate-950">Explore the site</h2>
  <div class="prose-content mt-5 max-w-3xl" @raw="content"></div>
  <ul class="mt-8 grid gap-4 sm:grid-cols-2">
    <li webc:for="item of site.exploreLinks">
      <a class="block rounded-lg border border-slate-200 p-5 no-underline transition hover:border-teal-500 hover:bg-teal-50" :href="item.url">
        <strong class="block text-lg text-slate-950" @text="item.label"></strong>
        <span class="mt-1 block text-sm text-slate-600" @text="item.description"></span>
      </a>
    </li>
  </ul>
</section>
