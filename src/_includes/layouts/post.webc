---
layout: base.webc
---
<article>
  <header class="mx-auto max-w-4xl text-center">
    <post-type-marker :type="type" :@site="site"></post-type-marker>
    <h1 class="mt-4 text-4xl font-black tracking-tight text-slate-950 md:text-6xl" @text="title"></h1>
    <p class="mt-3 text-sm text-slate-600">By <a href="/about/" rel="author" @text="site.title"></a></p>
    <p class="mt-5 text-sm font-semibold uppercase tracking-wider text-slate-500"><content-date :@value="date"></content-date></p>
    <p webc:if="updated" class="mt-2 text-sm text-slate-500">Updated <content-date :@value="updated"></content-date></p>
    <div class="flex justify-center"><topic-links :@topics="topics"></topic-links></div>
  </header>
  <div webc:if="type !== 'video'" class="mx-auto mt-10 max-w-6xl overflow-hidden rounded-xl shadow-xl"><post-visual :@banner="displayBanner" :type="type" :@site="site" :@featured="false"></post-visual></div>
  <div webc:if="type === 'video'" class="mx-auto mt-10 max-w-6xl"><video-player :@video="video" :title="title"></video-player></div>
  <div class="relative mx-auto max-w-4xl rounded-xl bg-white p-7 shadow-xl md:p-14" :class="type === 'video' ? 'mt-8' : '-mt-2 md:-mt-16'">
    <p webc:if="summary" class="mb-8 border-l-4 border-teal-600 pl-5 font-serif text-xl leading-8 text-slate-700" @text="summary"></p>
    <game-details webc:if="type === 'gamelog'" :@game="gameMetadata"></game-details>
    <gamelog-details webc:if="type === 'gamelog'" :@custom-data="customData"></gamelog-details>
    <video-links webc:if="type === 'video'" :@links="video.links"></video-links>
    <section class="prose-content" aria-label="Post content" @raw="content"></section>
  </div>
  <share-content :share-url="pageMetadata.canonicalUrl" :share-title="title"></share-content>
  <content-navigation :@model="contentNavigation" :@site="site"></content-navigation>
</article>
